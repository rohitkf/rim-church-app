.env
.env.*
!.env.example
!*/.env.example

# A stray vitest run from the repo root leaves a cache here.
node_modules/

# Supabase CLI state (supabase link / start)
supabase/.temp/
supabase/.branches/

# The code graph graphify builds (rebuild: graphify extract . --code-only). Generated, large, and stale by the next commit.
graphify-out/

# /brag writes here when run from the repo; its videos are not the app's
brag-output*/
