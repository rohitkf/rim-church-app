# Used by `docker compose build`/`up` to configure both containers from one
# place. Copy to `.env` and fill in your Supabase project's values — see
# frontend/.env.example and backend/.env.example for what each is for.

# Frontend (baked into the static bundle at build time — see frontend/Dockerfile)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_AI_ASSISTANT_ENABLED=false

# Backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LLM_API_KEY=your-anthropic-api-key
CORS_ORIGINS_RAW=http://localhost:8080
# ANTHROPIC_MODEL=claude-opus-5
# WHISPER_MODEL_SIZE=base
