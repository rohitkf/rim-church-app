VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# FastAPI assistant service (Phase 9). Defaults to the local dev server.
VITE_API_BASE_URL=http://localhost:8000
# The AI Assistant button is built but shows as "Coming Soon" until the
# backend is actually deployed somewhere. Set to "true" once it is.
VITE_AI_ASSISTANT_ENABLED=false

# Web Push. Optional: without it, notifications still appear while the app
# is open or backgrounded, but not once it is fully closed. Generate a pair
# with `npx web-push generate-vapid-keys` — the public half goes here, the
# private half into the Supabase Edge Function's secrets. See
# supabase/functions/push-notify/index.ts.
VITE_VAPID_PUBLIC_KEY=
